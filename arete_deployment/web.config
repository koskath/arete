<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Configuration for Server-Sent Events (SSE) streaming endpoint -->
  <location path="api/chat/stream">
    <system.webServer>

      <!-- Disable IIS compression for SSE streaming -->
      <urlCompression
        doStaticCompression="false"
        doDynamicCompression="false" />

      <!-- Disable response buffering for real-time streaming -->
      <serverRuntime enabled="true" />

      <httpProtocol>
        <customHeaders>
          <!-- Prevent IIS/proxy buffering of SSE streams -->
          <add name="X-Accel-Buffering" value="no" />
          <!-- Additional cache control headers (app also sets these, but these ensure they're present) -->
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
          <add name="Pragma" value="no-cache" />
          <add name="Expires" value="0" />
        </customHeaders>
      </httpProtocol>

      <!-- Avoid managed pipeline modules that might buffer responses -->
      <modules runAllManagedModulesForAllRequests="false" />

    </system.webServer>
  </location>

  <!-- Global IIS configuration -->
  <system.webServer>
    <!-- Ensure outbound rewrite rules do NOT interfere with SSE streams -->
    <rewrite>
      <outboundRules>
        <preConditions>
          <preCondition name="IsHtml">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
  </system.webServer>

</configuration>
